{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage.schema.json",
  "title": "Matriz de cobertura WCAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "criteria"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "auditId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "level",
          "applicability",
          "outcome",
          "methods",
          "sampleIds",
          "evidence",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-4]\\.[1-9]\\.[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "level": { "enum": ["A", "AA"] },
          "applicability": {
            "enum": ["applicable", "inapplicable", "undetermined"]
          },
          "outcome": {
            "enum": ["passed", "failed", "inapplicable", "cantTell", "untested"]
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "name"],
              "properties": {
                "type": { "enum": ["automatic", "agent-assisted", "human"] },
                "name": { "type": "string", "minLength": 1 },
                "skill": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              }
            }
          },
          "sampleIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "inapplicable" } } },
            "then": {
              "properties": { "applicability": { "const": "inapplicable" } }
            }
          }
        ]
      }
    }
  }
}
