{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Mapa de la experiencia",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "technologies", "views", "processes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "auditId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "kind", "essential", "states"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/" },
          "kind": { "type": "string", "minLength": 1 },
          "essential": { "type": "boolean" },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "name": { "type": "string", "minLength": 1 },
                "trigger": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["viewId", "stateId"],
              "properties": {
                "viewId": { "type": "string", "minLength": 1 },
                "stateId": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
