{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "Hallazgos de accesibilidad",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "auditId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "criterion",
          "title",
          "impact",
          "impactDescription",
          "sampleIds",
          "stepsToReproduce",
          "expected",
          "observed",
          "evidence",
          "visualEvidence",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "enum": ["confirmed", "needs-review", "dismissed"] },
          "criterion": {
            "type": "string",
            "pattern": "^[1-4]\\.[1-9]\\.[0-9]+$"
          },
          "title": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["critical", "serious", "moderate", "minor"] },
          "impactDescription": { "type": "string", "minLength": 1 },
          "sampleIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "stepsToReproduce": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expected": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "reference", "description"],
              "properties": {
                "type": { "enum": ["axe", "snapshot", "screenshot", "note"] },
                "reference": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "visualEvidence": {
            "oneOf": [
              {
                "title": "Captura disponible",
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "reference", "description", "annotation"],
                "properties": {
                  "status": { "const": "captured" },
                  "reference": {
                    "type": "string",
                    "pattern": "^evidence/.+\\.(png|jpg|jpeg|webp)$"
                  },
                  "description": { "type": "string", "minLength": 1 },
                  "annotation": { "const": "red-rectangle" }
                }
              },
              {
                "title": "El problema no puede representarse en una imagen",
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "reason"],
                "properties": {
                  "status": { "const": "not-capturable" },
                  "reason": { "type": "string", "minLength": 10 }
                }
              }
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
